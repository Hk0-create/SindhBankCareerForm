@model CvSearchViewModel
@{
    ViewData["Title"] = "Search CV's";
    Layout = "_PortalLayout";
}

<div class="portal-card portal-search-card">
    <h2>Search CV's</h2>
    <p class="portal-subtitle">Use any combination of filters below, or leave all blank to see everyone.</p>

    <form asp-controller="Search" asp-action="Index" method="get" id="cvSearchForm" class="portal-filter-form">
        <input type="hidden" name="HasSearched" value="true" />

        <!-- Row 1: dates + position -->
        <div class="portal-filter-row">
            <div class="portal-field">
                <label for="DateFrom">Submitted From</label>
                <input type="date" id="DateFrom" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="portal-field">
                <label for="DateTo">Submitted To</label>
                <input type="date" id="DateTo" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="portal-field">
                <label for="PositionAppliedFor">Position</label>
                <select id="PositionAppliedFor" name="PositionAppliedFor">
                    <option value="">Any Position</option>
                    @foreach (var position in Model.AvailablePositions)
                    {
                        <option selected="@(Model.PositionAppliedFor == position)">@position</option>
                    }
                </select>
            </div>
        </div>

        <!-- Row 2: reference number, location, mobile number -->
        <div class="portal-filter-row">
            <div class="portal-field">
                <label for="ApplicationNumber">Reference Number</label>
                <input type="text" id="ApplicationNumber" name="ApplicationNumber" value="@Model.ApplicationNumber" placeholder="e.g. SB-0000012" />
            </div>
            <div class="portal-field">
                <label for="JobLocation">Location</label>
                <select id="JobLocation" name="JobLocation">
                    <option value="">Any Location</option>
                    @foreach (var location in Model.AvailableLocations)
                    {
                        <option selected="@(Model.JobLocation == location)">@location</option>
                    }
                </select>
            </div>
            <div class="portal-field">
                <label for="MobileNumber">Phone Number</label>
                <input type="text" id="MobileNumber" name="MobileNumber" value="@Model.MobileNumber" placeholder="Search by mobile number" />
            </div>
        </div>

        <!-- Row 3: name, gender, CNIC -->
        <div class="portal-filter-row">
            <div class="portal-field">
                <label for="Name">Name</label>
                <input type="text" id="Name" name="Name" value="@Model.Name" placeholder="Search by name" />
            </div>
            <div class="portal-field">
                <label for="Gender">Gender</label>
                <select id="Gender" name="Gender">
                    <option value="">Any</option>
                    <option selected="@(Model.Gender == "Male")">Male</option>
                    <option selected="@(Model.Gender == "Female")">Female</option>
                </select>
            </div>
            <div class="portal-field">
                <label for="CnicNo">CNIC</label>
                <input type="text" id="CnicNo" name="CnicNo" value="@Model.CnicNo" placeholder="Search by CNIC" />
            </div>
        </div>
    </form>

    <!-- Separate form that reuses the existing Download/ByList action.
         It stays hidden — only its hidden input + button are used,
         the button itself is rendered below in the shared action row
         via the "form" attribute, which submits a button to a form
         it isn't physically nested inside. -->
    <form asp-controller="Download" asp-action="ByList" method="post" id="downloadSelectedForm" class="portal-hidden-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="numbersCsv" id="selectedNumbersCsv" value="" />
    </form>

    <!-- Row 4: Search + Download, centered, side by side -->
    <div class="portal-action-row">
        <button type="submit" form="cvSearchForm" class="portal-action-btn portal-search-btn">Search</button>
        <button type="submit" form="downloadSelectedForm" id="downloadSelectedBtn" class="portal-action-btn portal-download-btn" disabled>Download Selected</button>
    </div>

    @if (Model.HasSearched)
    {
        <div class="portal-results">
            @if (Model.Results.Count == 0)
            {
                <p class="portal-empty">No applications matched your filters.</p>
            }
            else
            {
                <p class="portal-result-count">@Model.Results.Count result(s) found. Scroll right to see all columns.</p>
                <div class="portal-table-wrap">
                    <table class="portal-table">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Select</th>
                                <th>Ref No</th>
                                <th>Position Applied</th>
                                <th>Name</th>
                                <th>CNIC</th>
                                <th>Date of Birth</th>
                                <th>Relative</th>
                                <th>Domicile</th>
                                <th>City</th>
                                <th>Pre Employed</th>
                                <th>Apply Date</th>
                                <th>Religion</th>
                                <th>Secondary Education</th>
                                <th>High Education</th>
                                <th>Qualification (Graduation)</th>
                                <th>Qualification (Master)</th>
                                <th>Professional Qualification</th>
                                <th>Banking Exp</th>
                                <th>Current Organization</th>
                                <th>Current Designation</th>
                                <th>Mobile No</th>
                                <th>Email</th>
                                <th>Location</th>
                                <th>Disability</th>
                                <th>Disability Type</th>
                                <th>Disability Desc</th>
                                <th>Gender</th>
                                <th>CV</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowNumber = 1;
                            }
                            @foreach (var item in Model.Results)
                            {
                                <tr>
                                    <td>@rowNumber</td>
                                    <td>
                                        <input type="checkbox" class="cv-select-checkbox" value="@item.ApplicationNumber" />
                                    </td>
                                    <td>@item.ApplicationNumber</td>
                                    <td>@item.PositionAppliedFor</td>
                                    <td>@item.Name</td>
                                    <td>@item.CnicNo</td>
                                    <td>@(item.DateOfBirth?.ToString("dd MMM yyyy"))</td>
                                    <td>@item.RelativeInSindhBank</td>
                                    <td>@item.Domicile</td>
                                    <td>@item.CityOfResidence</td>
                                    <td>@item.PreviouslyEmployeeOfSindhBank</td>
                                    <td>@item.SubmittedDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.Religion</td>
                                    <td>@item.SecondaryEducation</td>
                                    <td>@item.HigherSecondaryEducation</td>
                                    <td>@item.Bachelors</td>
                                    <td>@item.Masters</td>
                                    <td>@item.OtherQualification</td>
                                    <td>@item.BankingExperienceYears</td>
                                    <td>@item.CurrentOrganization</td>
                                    <td>@item.CurrentDesignation</td>
                                    <td>@item.MobileNumber</td>
                                    <td>@item.Email</td>
                                    <td>@item.JobLocation</td>
                                    <td>@item.Disability</td>
                                    <td>@item.DisabilityType</td>
                                    <td>@item.DisabilityDescription</td>
                                    <td>@item.Gender</td>
                                    <td>
                                        @if (item.HasCv)
                                        {
                                            <a asp-controller="Search" asp-action="DownloadCv" asp-route-id="@item.ApplicationId" class="portal-download-link">Download</a>
                                        }
                                        else
                                        {
                                            <span class="portal-muted">No CV</span>
                                        }
                                    </td>
                                </tr>
                                rowNumber++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <a asp-controller="Dashboard" asp-action="Index" class="portal-back-link">&larr; Back to Dashboard</a>
</div>

<script>
    // Enables/disables the "Download Selected" button based on how
    // many result-row checkboxes are currently checked.
    function updateDownloadButtonState() {
        var checkedCount = document.querySelectorAll('.cv-select-checkbox:checked').length;
        document.getElementById('downloadSelectedBtn').disabled = (checkedCount === 0);
    }

    document.querySelectorAll('.cv-select-checkbox').forEach(function(checkbox) {
        checkbox.addEventListener('change', updateDownloadButtonState);
    });

    // Right before the hidden download form submits, collect every
    // checked checkbox's Application Number and join them into the
    // same comma-separated format the existing ByList action expects.
    document.getElementById('downloadSelectedForm').addEventListener('submit', function() {
        var selectedNumbers = Array.from(document.querySelectorAll('.cv-select-checkbox:checked'))
            .map(function(checkbox) { return checkbox.value; });
        document.getElementById('selectedNumbersCsv').value = selectedNumbers.join(',');
    });
</script>